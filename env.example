# 🌌 Lumora Social - Variables de Entorno

# =============================================================================
# SUPABASE (Backend y Base de Datos)
# =============================================================================
# Obtén estas credenciales desde: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-supabase

# =============================================================================
# STRIPE (Sistema de Pagos)
# =============================================================================
# Obtén estas credenciales desde: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tu-clave-publica-stripe
STRIPE_SECRET_KEY=sk_test_tu-clave-secreta-stripe
STRIPE_WEBHOOK_SECRET=whsec_tu-webhook-secret

# =============================================================================
# ANALYTICS Y MONITOREO
# =============================================================================
# Google Analytics
NEXT_PUBLIC_GA_ID=G-TU-ID-GOOGLE-ANALYTICS

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=tu-id-vercel-analytics

# =============================================================================
# AUTENTICACIÓN Y SEGURIDAD
# =============================================================================
# JWT Secret (para tokens de autenticación)
JWT_SECRET=tu-jwt-secret-super-seguro

# NextAuth (si usas NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu-nextauth-secret

# =============================================================================
# SERVICIOS EXTERNOS
# =============================================================================
# Email (SendGrid, Mailgun, etc.)
SENDGRID_API_KEY=tu-api-key-sendgrid
MAILGUN_API_KEY=tu-api-key-mailgun

# Almacenamiento (AWS S3, Cloudinary, etc.)
AWS_ACCESS_KEY_ID=tu-aws-access-key
AWS_SECRET_ACCESS_KEY=tu-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=tu-bucket-s3

# =============================================================================
# DESARROLLO Y DEBUGGING
# =============================================================================
# Modo de desarrollo
NODE_ENV=development

# Debug (solo en desarrollo)
DEBUG=lumora:*

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 1. Nunca subas este archivo al repositorio
# 2. Crea un archivo .env.local con tus credenciales reales
# 3. Mantén las claves secretas seguras
# 4. Usa diferentes credenciales para desarrollo y producción
